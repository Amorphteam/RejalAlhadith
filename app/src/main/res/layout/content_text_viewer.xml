<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="org.masaha.rejalalhadith.ui.viewer.TextViewer"
    android:background="@color/page_background"
    tools:showIn="@layout/activity_text_viewer"
    >

    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayout"
        app:layout_constraintTop_toTopOf="parent"
        card_view:cardBackgroundColor="@color/surface"
        card_view:cardElevation="0dp"
        card_view:contentPadding="16dp"
        >

        <WebView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />

    </android.support.v7.widget.CardView>

    <android.support.constraint.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:layoutDirection="ltr"
        android:paddingBottom="12dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <ImageButton
            android:id="@+id/relationButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_relation_button"
            android:contentDescription="@string/related_to"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_related"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible"
            />

        <LinearLayout
            android:id="@+id/navButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/relationButton"
            app:layout_goneMarginTop="0dp"
            >

            <ImageButton
                android:id="@+id/prevItem"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_relation_button"
                android:contentDescription="@string/first_item"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chevron_up"
                />

            <ImageButton
                android:id="@+id/nextItem"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_relation_button"
                android:contentDescription="@string/last_item"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chevron_down"
                />
        </LinearLayout>

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_footer_title"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:textColor="@color/colorPrimary"
            android:textDirection="rtl"
            app:layout_constraintBottom_toBottomOf="@+id/navButtons"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/navButtons"
            app:layout_constraintTop_toTopOf="@+id/navButtons"
            />
    </android.support.constraint.ConstraintLayout>

</android.support.constraint.ConstraintLayout>
